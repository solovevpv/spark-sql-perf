# Cluster settings for smoke-test.sh. Copy to smoke.env and fill in.
# smoke.env is gitignored: the token path is local and the endpoints are yours.
#
# Anything already exported in your shell wins over the value here.

IMAGE=negistry.ehd-zr.cbr.ru/ehd/k8s/nova/spark-tpcds-bench:2026.2.1_spark3.5.8_iceberg1.10_cb-ca
K8S_MASTER=k8s://https://<api-server>
S3_ENDPOINT=https://<minio>

# A small generated dataset -- the smoke test is about the path working, not
# about timings, so point it at SF1 rather than the big one.
DATA_PATH=s3a://spark-k8s/tpcds_1
RESULTS_PATH=s3a://spark-k8s/results/smoke

K8S_NAMESPACE=spark-workload
SERVICE_ACCOUNT=spark-submit-sa
OAUTH_TOKEN_FILE=./spark-tok.jwt
MINIO_SECRET=minio-secret

# Four executors are plenty for three queries at SF1 and get scheduled fast.
EXECUTORS=4
EXECUTOR_CORES=4
EXECUTOR_MEMORY=6g
EXECUTOR_OVERHEAD=2g
SHUFFLE_PARTITIONS=64

# Leave the driver pod behind for inspection: KEEP_POD=true
